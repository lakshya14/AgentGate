# ==========================================
# Database Configuration
# ==========================================
# The connection string for your PostgreSQL database (must have pgvector enabled).
# Format: postgresql+psycopg://user:password@hostname/dbname
DATABASE_URL=postgresql+psycopg://user:password@hostname/dbname

# ==========================================
# GitHub Configuration
# ==========================================
# The target repository where AgentGate will triage issues (format: owner/repo)
GITHUB_REPO=owner/repo-name
# A Personal Access Token (PAT) or App token with read/write access to issues
GITHUB_TOKEN=your_github_pat_or_app_installation_token_here
# The secret string used to verify incoming webhooks from GitHub via HMAC-SHA256
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# ==========================================
# Discord Configuration (Human-in-the-loop)
# ==========================================
# The bot token used to send approval messages to the channel
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# The public key used to verify interactions (button clicks) from Discord via Ed25519
DISCORD_PUBLIC_KEY=your_discord_application_public_key_here
# The ID of the Discord channel where approval messages should be posted
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# ==========================================
# LLM Configuration
# ==========================================
# Google Gemini API key for classification, embeddings, and action drafting
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# LangSmith Observability
# ==========================================
# Enable LangSmith tracing for LangGraph nodes and LLM calls
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=AgentGate
LANGCHAIN_API_KEY=your_langchain_api_key_here
